# PostgreSQL (Docker Compose defaults)
POSTGRES_DB=health_app
POSTGRES_USER=health_app
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=55432

# Backend
DATABASE_URL=postgresql+psycopg://health_app:change-me-for-local-development@db:5432/health_app
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173
APP_ENV=development
TRUSTED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
# Session cookie is HttpOnly and defaults to Secure when APP_ENV=production.
# Override COOKIE_SECURE only for an intentional non-default deployment case.
SESSION_TTL_MINUTES=10080

# Frontend
FRONTEND_PORT=5173
# Docker frontend defaults to the same-origin nginx proxy at /api.
# Local Vite development can use this URL when it talks directly to FastAPI.
VITE_API_BASE_URL=http://localhost:8000
